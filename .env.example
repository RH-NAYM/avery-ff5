# --- LiveKit server connection ---
# For a local self-hosted server started with `livekit-server --dev`, the
# defaults below (devkey/secret) work out of the box. For LiveKit Cloud,
# replace these with the values from your project settings.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# ------------------------------------------------------------------------------
# Speech-to-text
# ------------------------------------------------------------------------------
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# STT_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v1
# STT_PROVIDER=google
# Google Cloud Speech-to-Text - see the "Google Cloud (service account)"
# block below for GOOGLE_APPLICATION_CREDENTIALS.

# ------------------------------------------------------------------------------
# LLM
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=gemini without GEMINI_API_KEY set automatically falls back to
# Vertex AI, using the "Google Cloud (service account)" credentials below.

# ------------------------------------------------------------------------------
# Text-to-speech
# ------------------------------------------------------------------------------
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# TTS_PROVIDER=gemini
# GEMINI_TTS_VOICE=Kore
# TTS_PROVIDER=cartesia
# CARTESIA_API_KEY=
# TTS_PROVIDER=google
# Google Cloud Text-to-Speech (distinct from TTS_PROVIDER=gemini above,
# which uses Gemini's own TTS model) - see the "Google Cloud (service
# account)" block below for GOOGLE_APPLICATION_CREDENTIALS.
# GOOGLE_TTS_VOICE=en-US-Chirp3-HD-Charon
# TTS_PROVIDER=coqui
# Coqui XTTS v2 runs locally (CPU/GPU) instead of calling a cloud API - see
# the "Coqui XTTS v2 (local)" section in README.md for setup. No API key
# needed; the options below are all optional.
# COQUI_XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# COQUI_XTTS_LANGUAGE=en
# COQUI_XTTS_SPEAKER=Claribel Dervla
# COQUI_XTTS_SPEAKER_WAV=
# COQUI_XTTS_DEVICE=auto

# ------------------------------------------------------------------------------
# Google Cloud (service account)
# ------------------------------------------------------------------------------
# Shared by STT_PROVIDER=google, TTS_PROVIDER=google, and the Vertex AI
# fallback for LLM_PROVIDER=gemini. Download a service account key (JSON)
# with the Cloud Speech-to-Text, Cloud Text-to-Speech, and/or Vertex AI
# User roles from Google Cloud Console, keep it out of version control (see
# .gitignore), and point to it here.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Optional ---
# ai-coustics noise cancellation is skipped unless you provide your own
# license key here (https://ai-coustics.com/). Without it, LiveKit Cloud
# would otherwise be required just to bill/authorize that one feature.
AI_COUSTICS_LICENSE_KEY=

# Outbound phone calls (Twilio via LiveKit SIP) - see the "Outbound Phone
# Calls (Twilio)" section in README.md. Requires LIVEKIT_URL/API_KEY/SECRET
# above to point at a LiveKit Cloud project (SIP isn't available on a local
# `livekit-server --dev` instance without separately self-hosting livekit-sip).
# SIP_OUTBOUND_TRUNK_ID=
